# Public site origin, used for canonical URLs, OGP and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where contact form submissions are delivered.
# Leave CONTACT_TO empty to run the form in "log only" mode during development.
CONTACT_TO=you@example.com

# Optional: Resend (https://resend.com) API key for real email delivery.
# When unset, /api/contact validates and logs the submission instead of sending.
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>
