# Public site origin, used for canonical URLs, OGP and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# EmailJS — the contact form sends straight from the browser.
# All three are public by design and ship in the client bundle either way;
# the defaults in src/content/emailjs.ts already point at the live account,
# so these are only needed to target a different one (a staging template,
# for instance).
#
# What actually protects the account is the origin allow-list:
#   EmailJS dashboard → Account → Security → Allowed Origins
#
# The template must use these variable names, or the mail arrives blank:
#   {{name}} {{email}} {{reply_to}} {{company}}
#   {{project_type}} {{budget}} {{deadline}} {{message}} {{locale}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
