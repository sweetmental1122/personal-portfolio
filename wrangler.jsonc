{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Hostnames cannot contain an underscore — DNS labels allow letters,
  // digits and hyphens only, and Cloudflare rejects a Worker name that
  // breaks that rule. "dream_catcher" becomes "dream-catcher", which is
  // what the workers.dev URL will read as.
  "name": "dream-catcher",
  "main": ".open-next/worker.js",

  // Required by @opennextjs/cloudflare: the adapter runs Next on the Node.js
  // runtime, and the date has to be 2024-09-23 or later for that to work.
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
